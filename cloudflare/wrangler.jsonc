{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pdcai-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "pdcai.matoruru.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz", "/readyz"],
  },
  "containers": [
    {
      "class_name": "Backend",
      "image": "../Dockerfile",
      "max_instances": 1,
      "instance_type": "lite",
      "constraints": {
        "regions": ["APAC"],
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "Backend",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Backend"],
    },
  ],
  "vars": {
    "PUBLIC_ORIGIN": "SET_BY_DEPLOY_WORKFLOW",
    "DB_MAX_OPEN_CONNS": "SET_BY_DEPLOY_WORKFLOW",
    "DB_MAX_IDLE_CONNS": "SET_BY_DEPLOY_WORKFLOW",
    "DB_CONN_MAX_LIFETIME_MINUTES": "SET_BY_DEPLOY_WORKFLOW",
    "SESSION_IDLE_DAYS": "SET_BY_DEPLOY_WORKFLOW",
    "SESSION_ABSOLUTE_DAYS": "SET_BY_DEPLOY_WORKFLOW",
    "SESSION_ACTIVITY_TOUCH_MINUTES": "SET_BY_DEPLOY_WORKFLOW",
    "ANONYMOUS_BOOTSTRAP_TTL_MINUTES": "SET_BY_DEPLOY_WORKFLOW",
    "MAX_PROGRESSING_GOALS": "SET_BY_DEPLOY_WORKFLOW",
    "AI_MODEL": "SET_BY_DEPLOY_WORKFLOW",
    "AI_MAX_INPUT_TOKENS": "SET_BY_DEPLOY_WORKFLOW",
    "AI_GOAL_REFINE_MAX_OUTPUT_TOKENS": "SET_BY_DEPLOY_WORKFLOW",
    "AI_ACTION_MAX_OUTPUT_TOKENS": "SET_BY_DEPLOY_WORKFLOW",
    "AI_MAX_CONTEXT_CYCLES": "SET_BY_DEPLOY_WORKFLOW",
    "AI_TIMEOUT_SECONDS": "SET_BY_DEPLOY_WORKFLOW",
    "AI_MAX_PROVIDER_ATTEMPTS": "SET_BY_DEPLOY_WORKFLOW",
    "AI_MAX_RETRY_BACKOFF_SECONDS": "SET_BY_DEPLOY_WORKFLOW",
    "AI_FINALIZATION_GRACE_SECONDS": "SET_BY_DEPLOY_WORKFLOW",
    "AI_LEASE_SECONDS": "SET_BY_DEPLOY_WORKFLOW",
    "AI_MAX_GENERATIONS_PER_USER_24H": "SET_BY_DEPLOY_WORKFLOW",
    "AI_GOAL_REFINE_PROMPT_VERSION": "SET_BY_DEPLOY_WORKFLOW",
    "AI_GENERATE_PROMPT_VERSION": "SET_BY_DEPLOY_WORKFLOW",
    "AI_REFINE_PROMPT_VERSION": "SET_BY_DEPLOY_WORKFLOW",
    "AI_TOKENIZER_ENCODING": "SET_BY_DEPLOY_WORKFLOW",
    "AI_MONTHLY_BUDGET_USD": "SET_BY_DEPLOY_WORKFLOW",
    "AI_WARNING_THRESHOLDS": "SET_BY_DEPLOY_WORKFLOW",
    "AI_PRICING_MODEL": "SET_BY_DEPLOY_WORKFLOW",
    "AI_PRICE_INPUT_USD_PER_MILLION": "SET_BY_DEPLOY_WORKFLOW",
    "AI_PRICE_OUTPUT_USD_PER_MILLION": "SET_BY_DEPLOY_WORKFLOW",
    "GOOGLE_WEB_CLIENT_ID": "SET_BY_DEPLOY_WORKFLOW",
    "RATE_ANONYMOUS_CREATE_PER_IP_HOUR": "SET_BY_DEPLOY_WORKFLOW",
    "RATE_ANONYMOUS_CREATE_PER_IP_24H": "SET_BY_DEPLOY_WORKFLOW",
    "RATE_AI_PER_USER_MINUTE": "SET_BY_DEPLOY_WORKFLOW",
    "RATE_AI_PER_SESSION_MINUTE": "SET_BY_DEPLOY_WORKFLOW",
    "RATE_AI_PER_IP_MINUTE": "SET_BY_DEPLOY_WORKFLOW",
  },
  "secrets": {
    "required": [
      "DATABASE_URL",
      "SESSION_TOKEN_PEPPER",
      "CSRF_TOKEN_PEPPER",
      "BOOTSTRAP_ID_PEPPER",
      "RATE_LIMIT_HMAC_SECRET",
      "CURSOR_SIGNING_SECRET",
      "OPENAI_API_KEY",
      "TURNSTILE_SECRET_KEY",
    ],
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
}
