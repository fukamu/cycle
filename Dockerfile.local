# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e

FROM ghcr.io/pnpm/pnpm:11.22.0@sha256:eba76954b37ec1ba6187f0adb39caee1e31733194857eedd01319da0af3fa00d AS pnpm-runtime

FROM node:24-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS frontend-build
WORKDIR /src
COPY --from=pnpm-runtime /opt/pnpm/dist /opt/pnpm/dist
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY frontend/package.json frontend/package.json
COPY cloudflare/package.json cloudflare/package.json
RUN node /opt/pnpm/dist/pnpm.mjs install --frozen-lockfile --filter fukamu-cycle-frontend
COPY frontend/ frontend/
RUN node /opt/pnpm/dist/pnpm.mjs --filter fukamu-cycle-frontend run build

FROM golang:1.26.6-alpine@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS backend-build
WORKDIR /src/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/server ./cmd/server \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/migrate ./cmd/migrate

FROM alpine:3.24@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=backend-build --chown=65532:65532 /out/server /app/server
COPY --from=backend-build --chown=65532:65532 /out/migrate /app/migrate
COPY --chown=65532:65532 backend/migrations /app/migrations
COPY --from=frontend-build --chown=65532:65532 /src/frontend/dist /app/static
ENV HTTP_ADDRESS=:8080 \
    STATIC_DIR=/app/static
EXPOSE 8080
USER 65532:65532
CMD ["/app/server"]
