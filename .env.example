# Application
APP_ENV=development
PUBLIC_ORIGIN=http://localhost:5173
HTTP_ADDRESS=:8080

# PostgreSQL
DATABASE_URL=postgres://pdcai:pdcai@localhost:5432/pdcai?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_MINUTES=30

# Session and security (replace with high-entropy values outside local development)
SESSION_TOKEN_PEPPER=local-session-pepper-change-me
CSRF_TOKEN_PEPPER=local-csrf-pepper-change-me
BOOTSTRAP_ID_PEPPER=local-bootstrap-pepper-change-me
RATE_LIMIT_HMAC_SECRET=local-rate-limit-secret-change-me
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=180
SESSION_ACTIVITY_TOUCH_MINUTES=15
ANONYMOUS_BOOTSTRAP_TTL_MINUTES=10

# AI
OPENAI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-5-mini
AI_MAX_INPUT_TOKENS=12000
AI_MAX_OUTPUT_TOKENS=800
AI_TIMEOUT_SECONDS=45
AI_MAX_PROVIDER_ATTEMPTS=2
AI_MAX_GENERATIONS_PER_USER_24H=10
AI_GENERATE_PROMPT_VERSION=generate-action-v1
AI_REFINE_PROMPT_VERSION=refine-action-v1
AI_TOKENIZER_ENCODING=o200k_base
AI_MONTHLY_BUDGET_USD=100
AI_WARNING_THRESHOLDS=0.5,0.8
AI_PRICE_MODEL=gpt-5-mini
AI_PRICE_INPUT_USD_PER_MILLION=0
AI_PRICE_OUTPUT_USD_PER_MILLION=0

# Authentication / abuse prevention
GOOGLE_WEB_CLIENT_ID=
RECAPTCHA_ENABLED=false
RECAPTCHA_PROJECT_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
RECAPTCHA_EXPECTED_ACTION=anonymous_bootstrap
RATE_ANONYMOUS_CREATE_PER_IP_HOUR=5
RATE_ANONYMOUS_CREATE_PER_IP_24H=20
RATE_AI_PER_USER_MINUTE=3
RATE_AI_PER_SESSION_MINUTE=3
RATE_AI_PER_IP_MINUTE=10
